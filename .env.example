# 复制成 site/.env.local 后填值。这里只有键名,没有任何真实凭据。
# 部署到 Vercel 时把同样的键写进项目环境变量。

# ── 数据库 ──────────────────────────────────────────────
# Neon Postgres。务必用 pooled 连接串(host 里含 -pooler),
# 直连在 serverless 下会把连接数打满。
DATABASE_URL=

# ── 认证(Clerk)──────────────────────────────────────────
# 本项目只开邮箱验证码登录。Clerk SDK 自己读这两个,代码里不出现。
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# 走同源代理时才需要;直连 Clerk 域名可以留空。
NEXT_PUBLIC_CLERK_PROXY_URL=
# Clerk 浏览器包改从 CDN 拉(见 layout.tsx 注释)。留空则经代理 /__clerk/ 拉,serverless 冷启动会让它间歇失败。
# 版本号要与 `curl -I https://<域名>/__clerk/npm/@clerk/clerk-js@6/dist/clerk.browser.js` 的 location 一致。
NEXT_PUBLIC_CLERK_JS_URL=https://cdn.jsdelivr.net/npm/@clerk/clerk-js@6.31.0/dist/clerk.browser.js
NEXT_PUBLIC_CLERK_UI_URL=https://cdn.jsdelivr.net/npm/@clerk/ui@1.32.1/dist/ui.browser.js

# ── 支付(Stripe)─────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# ── 站点 ────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://example.com
# 置 1 才摘掉全站 noindex。开发与预览环境保持不设。
NEXT_PUBLIC_LAUNCHED=

# ── 定时任务与管理接口 ──────────────────────────────────
# Vercel Cron 调 /api/cron/* 时用它鉴权,随便一串长随机值。
CRON_SECRET=
# /api/admin/* 的令牌,同上。
ADMIN_TOKEN=

# ── 邮件 ────────────────────────────────────────────────
# 接收入站邮件的 Cloudflare Worker 用它鉴权(见 worker/)。
INBOUND_EMAIL_TOKEN=
# 出站发信。二选一;都不配也能跑 —— 邮件会入队不丢,配好后自动补发。
# 但注意"入队"不是"送达":不配的话联系表单与告警你一封都收不到。
# 首选 Resend(发件域需先在 resend.com/domains 验证);MAIL_FROM 默认 noreply@<域名>。
RESEND_API_KEY=
MAIL_FROM=
# 或自建 webhook:POST {to,from,subject,html}
MAIL_WEBHOOK_URL=
MAIL_WEBHOOK_TOKEN=

# ── 可选 ────────────────────────────────────────────────
# Search Console API 的服务账号 JSON,base64 编码后放这里。
GOOGLE_SERVICE_ACCOUNT_B64=
# FlowGlance 访客分析的公开站点 ID(fw_pub_ 开头,不是密钥)。留空即不加载。
NEXT_PUBLIC_FLOWGLANCE_SITE=
